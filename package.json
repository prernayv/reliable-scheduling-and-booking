{
  "name": "slotbook",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/db/migrate.ts && tsx src/db/seed.ts && concurrently -k -n api,web npm:dev:api npm:dev:web",
    "dev:api": "tsx src/server/index.ts",
    "dev:web": "vite",
    "start": "tsx src/db/migrate.ts && tsx src/db/seed.ts && tsx src/server/index.ts",
    "build": "vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "load": "artillery run load/booking.yml",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "hono": "^4.10.7",
    "luxon": "^3.7.2",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "artillery": "^2.0.23",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
